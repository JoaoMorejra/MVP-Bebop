# Python build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.pytest_cache/

# ROS 2 build artifacts
install/
log/

# Frontend (bebop_mission_control)
bebop_mission_control/node_modules/
bebop_mission_control/dist/
bebop_mission_control/.gstack/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Environment and credentials
.env
.env.*

# Large binary models and weights
*.pt
*.onnx
*.engine

# Mission runtime media and evidence captures
*.jpg
*.jpeg
*.png
*.mp4
*.avi

# Allow UI brand assets in bebop_mission_control
!bebop_mission_control/public/assets/*.png
!bebop_mission_control/public/assets/*.jpg
!bebop_mission_control/public/assets/*.mp4

# Dynamic runtime configuration outputs
mission_config.json
active_config.json
accident_metadata_*.json
