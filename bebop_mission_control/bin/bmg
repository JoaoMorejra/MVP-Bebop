#!/usr/bin/env bash
# ==============================================================================
# BMG: Bebop Mission GUI - legacy entry point
# The launcher lives in <package>/scripts/bmg; this path is kept so `./bin/bmg`
# from the application directory still starts the same, current launcher.
# ==============================================================================

exec "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." >/dev/null 2>&1 && pwd)/scripts/bmg" "$@"
