<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fast DDS profile for the BMG station: camera samples of up to 2.76 MB
  (1280x720 bgr8) between the driver, the mission and the GCS bridges.

  SHM segment of 16 MB, so one raw frame and its successors fit in the shared
  segment instead of falling back to UDP fragments; UDP socket buffers of 8 MB,
  within net.core.rmem_max/wmem_max = 16 MB (/etc/sysctl.d/60-bmg-dds.conf,
  scripts/setup_station.sh). Loaded through FASTRTPS_DEFAULT_PROFILES_FILE.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>bmg_shm</transport_id>
      <type>SHM</type>
      <segment_size>16777216</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>bmg_udp</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>8388608</sendBufferSize>
      <receiveBufferSize>8388608</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="bmg_video" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>bmg_shm</transport_id>
        <transport_id>bmg_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
