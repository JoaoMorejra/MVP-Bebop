#!/usr/bin/env bash
# ==============================================================================
# BMG: Bebop Mission GUI - Desktop Mission Control Launcher
# ==============================================================================

set -e

# Resolve symlinks to find real script location
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
PACKAGE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
WS_DIR="$(cd "$PACKAGE_DIR/../.." && pwd)"

# Resolve application directory (monorepo package path or workspace fallback)
if [ -d "${PACKAGE_DIR}/bebop_mission_control" ]; then
    APP_DIR="${PACKAGE_DIR}/bebop_mission_control"
elif [ -d "${WS_DIR}/bebop_mission_control" ]; then
    APP_DIR="${WS_DIR}/bebop_mission_control"
else
    APP_DIR="${HOME}/ros2_ws/bebop_mission_control"
fi

MISSION_DIR="${PACKAGE_DIR}/mvp_mission_bebop"

# Activate Nectar SDK and ROS 2 environment. A bare `source` hands this
# script's arguments to the sourced file, and nectar-activate execs "$@" when
# it has any, so the positional parameters are cleared around the source and
# restored for Electron afterwards.
BMG_ARGS=("$@")
set --
if [ -f "${WS_DIR}/bin/nectar-activate" ]; then
    source "${WS_DIR}/bin/nectar-activate"
elif [ -f "${WS_DIR}/.venv/bin/activate" ]; then
    source "${WS_DIR}/.venv/bin/activate"
fi
set -- "${BMG_ARGS[@]}"

# Ensure graphical display is available
if [ -z "$DISPLAY" ]; then
    export DISPLAY=":0"
fi

# Check and launch application
if [ -d "$APP_DIR" ]; then
    # dist/ is gitignored, so a pull that advances src/ or electron/ leaves the
    # previous bundle in place; rebuild whenever any bundle input is newer.
    DIST_INDEX="$APP_DIR/dist/index.html"
    if [ ! -f "$DIST_INDEX" ]; then
        echo "[BMG] Initializing production build in $APP_DIR..."
        (cd "$APP_DIR" && npm run build)
    elif [ -n "$(find "$APP_DIR/src" "$APP_DIR/electron" -type f -newer "$DIST_INDEX" -print -quit 2>/dev/null)" ]; then
        echo "[BMG] Sources newer than dist/, rebuilding in $APP_DIR..."
        (cd "$APP_DIR" && npm run build)
    fi

    ELECTRON_BIN="$APP_DIR/node_modules/.bin/electron"
    if [ -x "$ELECTRON_BIN" ]; then
        cd "$MISSION_DIR"
        exec "$ELECTRON_BIN" --no-sandbox --disable-gpu-sandbox --disable-dev-shm-usage "$APP_DIR" "$@"
    else
        echo "[BMG] Error: electron binary not found in $APP_DIR/node_modules/.bin/" >&2
        exit 1
    fi
else
    echo "[BMG] Error: Application directory $APP_DIR not found." >&2
    exit 1
fi
