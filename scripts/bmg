#!/usr/bin/env bash
# ==============================================================================
# BMG: Bebop Mission GUI - Desktop Mission Control Launcher
# ==============================================================================

set -e

# Resolve symlinks to find real script location
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
PACKAGE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
WS_DIR="$(cd "$PACKAGE_DIR/../.." && pwd)"

# Fallback to standard workspace location if needed
if [ ! -d "$WS_DIR/bebop_mission_control" ] && [ -d "$HOME/ros2_ws/bebop_mission_control" ]; then
    WS_DIR="$HOME/ros2_ws"
    PACKAGE_DIR="$WS_DIR/src/mvp_mission_bebop"
fi

MISSION_DIR="${PACKAGE_DIR}/mvp_mission_bebop"
APP_DIR="${WS_DIR}/bebop_mission_control"

# Activate Nectar SDK and ROS 2 environment
if [ -f "${WS_DIR}/bin/nectar-activate" ]; then
    source "${WS_DIR}/bin/nectar-activate"
elif [ -f "${WS_DIR}/.venv/bin/activate" ]; then
    source "${WS_DIR}/.venv/bin/activate"
fi

# Ensure graphical display is available
if [ -z "$DISPLAY" ]; then
    export DISPLAY=":0"
fi

# Check and launch application
if [ -d "$APP_DIR" ]; then
    if [ ! -f "$APP_DIR/dist/index.html" ]; then
        echo "[BMG] Initializing production build in $APP_DIR..."
        (cd "$APP_DIR" && npm run build)
    fi

    ELECTRON_BIN="$APP_DIR/node_modules/.bin/electron"
    if [ -x "$ELECTRON_BIN" ]; then
        cd "$MISSION_DIR"
        exec "$ELECTRON_BIN" --no-sandbox --disable-gpu-sandbox --disable-dev-shm-usage "$APP_DIR" "$@"
    else
        echo "[BMG] Error: electron binary not found in $APP_DIR/node_modules/.bin/" >&2
        exit 1
    fi
else
    echo "[BMG] Error: Application directory $APP_DIR not found." >&2
    exit 1
fi
